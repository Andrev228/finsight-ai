# ---- App ----
APP_ENV=local
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000

# ---- Database ----
# Uses the pgvector-enabled Postgres from docker-compose
DATABASE_URL=postgresql+asyncpg://finsight:finsight@db:5432/finsight

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Plaid (Sandbox only) ----
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
PLAID_CLIENT_USER_ID=local-development-user
PLAID_TOKEN_ENCRYPTION_KEY=generate_a_fernet_key

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ---- Langfuse (observability) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
