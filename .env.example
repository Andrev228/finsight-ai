# ---- App ----
APP_ENV=local
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_API_KEY=generate_a_long_random_local_admin_key
AUTH_JWT_SECRET=generate_at_least_32_random_bytes
AUTH_JWT_ISSUER=finsight-ai
AUTH_JWT_AUDIENCE=finsight-ai-api
ALLOW_INSECURE_LOCAL_AUTH=true
ALLOW_INSECURE_LOCAL_ADMIN=true
AI_REQUESTS_PER_MINUTE=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/?billing=cancelled
MCP_USER_ID=local-development-user

# ---- Database ----
# Uses the pgvector-enabled Postgres from docker-compose
DATABASE_URL=postgresql+psycopg://finsight:finsight@db:5432/finsight

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Plaid (Sandbox only) ----
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
PLAID_CLIENT_USER_ID=local-development-user
PLAID_TOKEN_ENCRYPTION_KEY=generate_a_fernet_key

# ---- Google Gemini ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
