  "outputs": {
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-api', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "webUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-web', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('namePrefix'))), '2024-08-01').fullyQualifiedDomainName]"
    }
  }
}