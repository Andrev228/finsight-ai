{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "8737070372443288857"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "metadata": {
        "description": "Globally unique prefix for Azure resources."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "backendImage": {
      "type": "string"
    },
    "frontendImage": {
      "type": "string"
    },
    "containerRegistryServer": {
      "type": "string"
    },
    "containerRegistryUsername": {
      "type": "securestring"
    },
    "containerRegistryPassword": {
      "type": "securestring"
    },
    "postgresAdminPassword": {
      "type": "securestring"
    },
    "plaidSecret": {
      "type": "securestring"
    },
    "plaidEncryptionKey": {
      "type": "securestring"
    },
    "geminiApiKey": {
      "type": "securestring"
    },
    "jwtSecret": {
      "type": "securestring"
    },
    "adminApiKey": {
      "type": "securestring"
    },
    "stripeSecretKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "stripeWebhookSecret": {
      "type": "securestring",
      "defaultValue": ""
    },
    "stripePriceId": {
      "type": "string",
      "defaultValue": ""
    },
    "plaidClientId": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}-postgres', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "finsightadmin",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "version": "16",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-postgres', parameters('namePrefix')), 'finsight')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/configurations",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-postgres', parameters('namePrefix')), 'azure.extensions')]",
      "properties": {
        "value": "VECTOR",
        "source": "user-override"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-postgres', parameters('namePrefix')), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-redis', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "ingress": {
            "external": false,
            "targetPort": 6379,
            "transport": "tcp"
          }
        },
        "template": {
          "containers": [
            {
              "name": "redis",
              "image": "redis:7-alpine",
              "command": [
                "redis-server"
              ],
              "args": [
                "--save",
                "",
                "--appendonly",
                "no",
                "--maxmemory",
                "128mb",
                "--maxmemory-policy",
                "allkeys-lru"
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-api', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": [
            {
              "server": "[parameters('containerRegistryServer')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "registry-password"
            }
          ],
          "secrets": [
            {
              "name": "registry-password",
              "value": "[parameters('containerRegistryPassword')]"
            },
            {
              "name": "database-url",
              "value": "[format('postgresql://finsightadmin:{0}@{1}:5432/finsight?sslmode=require', uriComponent(parameters('postgresAdminPassword')), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('namePrefix'))), '2024-08-01').fullyQualifiedDomainName)]"
            },
            {
              "name": "plaid-secret",
              "value": "[parameters('plaidSecret')]"
            },
            {
              "name": "plaid-encryption-key",
              "value": "[parameters('plaidEncryptionKey')]"
            },
            {
              "name": "gemini-key",
              "value": "[parameters('geminiApiKey')]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "admin-key",
              "value": "[parameters('adminApiKey')]"
            },
            {
              "name": "stripe-secret",
              "value": "[parameters('stripeSecretKey')]"
            },
            {
              "name": "stripe-webhook-secret",
              "value": "[parameters('stripeWebhookSecret')]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "http",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[parameters('backendImage')]",
              "env": [
                {
                  "name": "APP_ENV",
                  "value": "production"
                },
                {
                  "name": "FRONTEND_ORIGIN",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-web', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "DATABASE_URL",
                  "secretRef": "database-url"
                },
                {
                  "name": "REDIS_URL",
                  "value": "[format('redis://{0}:6379/0', reference(resourceId('Microsoft.App/containerApps', format('{0}-redis', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "PLAID_CLIENT_ID",
                  "value": "[parameters('plaidClientId')]"
                },
                {
                  "name": "PLAID_SECRET",
                  "secretRef": "plaid-secret"
                },
                {
                  "name": "PLAID_TOKEN_ENCRYPTION_KEY",
                  "secretRef": "plaid-encryption-key"
                },
                {
                  "name": "GEMINI_API_KEY",
                  "secretRef": "gemini-key"
                },
                {
                  "name": "AUTH_JWT_SECRET",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "ADMIN_API_KEY",
                  "secretRef": "admin-key"
                },
                {
                  "name": "STRIPE_SECRET_KEY",
                  "secretRef": "stripe-secret"
                },
                {
                  "name": "STRIPE_WEBHOOK_SECRET",
                  "secretRef": "stripe-webhook-secret"
                },
                {
                  "name": "STRIPE_PRICE_ID",
                  "value": "[parameters('stripePriceId')]"
                },
                {
                  "name": "STRIPE_SUCCESS_URL",
                  "value": "[format('https://{0}/?billing=success', reference(resourceId('Microsoft.App/containerApps', format('{0}-web', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "STRIPE_CANCEL_URL",
                  "value": "[format('https://{0}/?billing=cancelled', reference(resourceId('Microsoft.App/containerApps', format('{0}-web', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/ready",
                    "port": 8000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('namePrefix')))]",
        "[resourceId('Microsoft.App/containerApps', format('{0}-redis', parameters('namePrefix')))]",
        "[resourceId('Microsoft.App/containerApps', format('{0}-web', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-web', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": [
            {
              "server": "[parameters('containerRegistryServer')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "registry-password"
            }
          ],
          "secrets": [
            {
              "name": "registry-password",
              "value": "[parameters('containerRegistryPassword')]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "transport": "http",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "web",
              "image": "[parameters('frontendImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 2
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]"
      ]
    }
